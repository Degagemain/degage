{
  "name": "open-cars",
  "version": "0.0.9",
  "scripts": {
    "predev": "pnpm db:start && pnpm check:dev-account",
    "check:dev-account": "dotenv -e .env -- pnpx tsx scripts/check-dev-account.ts",
    "dev": "dotenv -e .env -- next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --config .prettierrc --check .",
    "format:fix": "prettier --config .prettierrc --write .",
    "fix": "pnpm lint:fix && pnpm format:fix",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:nuke": "docker compose down --volumes --remove-orphans",
    "db:reset": "pnpm db:start && dotenv -e .env -- prisma migrate reset --force",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:seed": "dotenv -e .env -- prisma db seed",
    "db:seed-dev-account": "dotenv -e .env -- pnpx tsx seeding/seed-dev-account.ts",
    "db:anonymize": "dotenv -e .env -- pnpx tsx scripts/anonymize.ts",
    "db:seed-e2e": "dotenv -e e2e/.env.e2e -- pnpx tsx e2e/seeding/seed-e2e.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "play-connector:mock": "pnpx tsx e2e/play-mock/server.ts",
    "play-connector:generate-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "gcp:setup-bucket": "bash scripts/gcp-setup-bucket.sh",
    "gcp:encode-credentials": "bash -c 'base64 < \"$1\" | tr -d \"\\n\"' _",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "validate-docs": "node scripts/validate-docs.mjs",
    "docs:sync-embeddings": "pnpx tsx scripts/sync-documentation-embeddings.ts",
    "benchmark": "dotenv -e .env -- pnpx tsx scripts/benchmark.ts",
    "worktree:init": "bash scripts/worktree-init.sh",
    "worktree:new": "bash scripts/worktree-new.sh"
  },
  "keywords": [],
  "author": "Mathias Colpaert",
  "license": "GPL-3.0",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.15.1",
  "dependencies": {
    "@ai-sdk/google": "^3.0.139",
    "@ai-sdk/react": "^3.0.319",
    "@better-auth/oauth-provider": "^1.7.12",
    "@google-cloud/storage": "^8.4.0",
    "@google/genai": "^1.52.0",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@posthog/ai": "^8.14.3",
    "@posthog/mcp": "^0.23.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rive-app/react-webgl2": "^4.27.3",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.10.1",
    "ai": "^6.0.316",
    "better-auth": "^1.7.12",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.553.0",
    "mcp-handler": "^2.3.0",
    "media-chrome": "^4.18.3",
    "motion": "^12.38.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "postcss": "^8.5.31",
    "posthog-js": "^1.438.13",
    "posthog-node": "^5.56.2",
    "radix-ui": "^1.4.3",
    "react": "^19.3.1",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.72.1",
    "react-jsx-parser": "^2.4.1",
    "resend": "^6.35.0",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.64.1",
    "@posthog/nextjs-config": "^1.11.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "^8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "pg": "^8.21.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "prisma": "^7.10.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.2",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.5"
  }
}
