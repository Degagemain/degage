# E2E / Playwright only (committed test values — do not use for pnpm dev)
# DATABASE_URL is overridden by Testcontainers during `pnpm e2e`; kept here for `pnpm db:seed-e2e` against local Docker Postgres.

E2E_ADMIN_EMAIL=admin@e2e.test
E2E_USER_EMAIL=user@e2e.test
E2E_PASSWORD=password

BETTER_AUTH_SECRET=e2e-test-secret-min-32-chars-long!!
BETTER_AUTH_URL=http://127.0.0.1:3100

DATABASE_URL=
DATABASE_URL_UNPOOLED=

RESEND_API_KEY=
RESEND_FROM=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL_DOMAINS=

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_BETTER_AUTH_SOCIAL_PROVIDERS=
